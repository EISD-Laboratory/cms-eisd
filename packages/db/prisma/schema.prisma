generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                 String    @id @default(uuid())
  slug               String    @unique
  title              String
  previewDescription String
  content            String
  coverImage         String
  headerImage        String
  galleryImages      String[]
  location           String
  startDate          DateTime
  endDate            DateTime
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([slug])
  @@index([startDate])
  @@index([publishedAt])
}

model MediumArticle {
  id            String    @id @default(uuid())
  url           String    @unique
  title         String
  description   String
  coverImage    String
  publishedDate DateTime
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([url])
  @@index([publishedAt])
}

model Achievement {
  id                   String              @id @default(uuid())
  category             String
  customCategory       String?
  level                String
  result               String
  competitionName      String
  competitionYearMonth String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  members              AchievementMember[]

  @@index([category])
  @@index([level])
  @@index([result])
  @@index([competitionYearMonth])
}

model AchievementMember {
  id            String      @id @default(uuid())
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  name          String
  assistantCode String      @unique

  @@index([achievementId])
}
